				<Option compiler="gcc" />
				<Option parameters="vmx Prueba.vmx -d" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Maquina Virtual" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="desensamblar.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="desensamblar.h">
			<Option target="&lt;{~None~}&gt;" />
		</Unit>
		<Unit filename="instruccion.c">
